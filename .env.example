DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=PIGP

# Clave para firmar la cookie de sesión del login. Genera una propia, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_this_secret

# Año usado como marcador de "fecha de nacimiento desconocida": si un líder
# nació este año, en la lista de líderes se muestra edad 0 en vez de calcularla.
SENTINEL_BIRTH_YEAR=1900
